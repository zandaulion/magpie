FROM docker.io/library/node:24-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY web ./web

RUN addgroup -g 10008 appgroup && \
    adduser -u 10008 -G appgroup -s /bin/sh -D appuser && \
    mkdir -p /data/images && chown -R 10008:10008 /data /app

VOLUME /data
ENV DATA_DIR=/data
ENV PORT=3000

USER 10008
EXPOSE 3000

CMD ["node", "server/index.js"]
